# Clave de acceso a la aplicacion (obligatoria)
APP_PASSWORD=cambia-esta-clave

# Clave para firmar la cookie de sesion. Si no se define se genera una al
# arrancar (lo que cierra las sesiones en cada reinicio del contenedor).
SECRET_KEY=cambia-esta-clave-secreta-larga

# Opcionales
SESSION_MAX_AGE=28800      # segundos que dura la sesion (8 h)
MAX_UPLOAD_MB=25           # tamano maximo por archivo subido
JOB_TTL_MINUTES=120        # tiempo que se guardan los datos en memoria
MAX_JOBS=6                 # trabajos simultaneos en memoria
