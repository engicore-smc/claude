<?xml version="1.0" encoding="utf-8"?>
<!-- Tres filas compactas: horas, temperaturas e indicadores. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- Hora y minuto: los TextClock avanzan solos, sin gastar batería en la app. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout style="@style/WColumna">
            <TextView style="@style/WEtiqueta" android:text="@string/chile" />
            <TextClock style="@style/WReloj" android:timeZone="America/Santiago" />
        </LinearLayout>

        <LinearLayout style="@style/WColumna">
            <TextView style="@style/WEtiqueta" android:text="@string/espana" />
            <TextClock style="@style/WReloj" android:timeZone="Europe/Madrid" />
        </LinearLayout>

        <TextView
            android:id="@+id/w_actualizado"
            style="@style/WEtiqueta"
            android:layout_gravity="top" />
    </LinearLayout>

    <LinearLayout style="@style/WFila">
        <LinearLayout style="@style/WColumna">
            <TextView android:id="@+id/w_nombre0" style="@style/WEtiqueta" />
            <TextView android:id="@+id/w_temp0" style="@style/WValor" />
        </LinearLayout>
        <LinearLayout style="@style/WColumna">
            <TextView android:id="@+id/w_nombre1" style="@style/WEtiqueta" />
            <TextView android:id="@+id/w_temp1" style="@style/WValor" />
        </LinearLayout>
        <LinearLayout style="@style/WColumna">
            <TextView android:id="@+id/w_nombre2" style="@style/WEtiqueta" />
            <TextView android:id="@+id/w_temp2" style="@style/WValor" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout style="@style/WFila">
        <LinearLayout style="@style/WColumna">
            <TextView style="@style/WEtiqueta" android:text="UF" />
            <TextView android:id="@+id/w_uf" style="@style/WIndicador" />
        </LinearLayout>
        <LinearLayout style="@style/WColumna">
            <TextView style="@style/WEtiqueta" android:text="US$" />
            <TextView android:id="@+id/w_dolar" style="@style/WIndicador" />
        </LinearLayout>
        <LinearLayout style="@style/WColumna">
            <TextView style="@style/WEtiqueta" android:text="€" />
            <TextView android:id="@+id/w_euro" style="@style/WIndicador" />
        </LinearLayout>
        <LinearLayout style="@style/WColumna">
            <TextView style="@style/WEtiqueta" android:text="IPC" />
            <TextView android:id="@+id/w_ipc" style="@style/WIndicador" />
        </LinearLayout>
        <LinearLayout style="@style/WColumna">
            <TextView style="@style/WEtiqueta" android:text="Hip." />
            <TextView android:id="@+id/w_tasa" style="@style/WIndicador" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
