<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Hora y minuto: los TextClock avanzan solos, sin gastar batería en la app. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout style="@style/WColumna">
            <TextView style="@style/WPais" android:text="@string/chile" />
            <TextClock style="@style/WReloj" android:timeZone="America/Santiago" />
        </LinearLayout>

        <LinearLayout style="@style/WColumna">
            <TextView style="@style/WPais" android:text="@string/espana" />
            <TextClock style="@style/WReloj" android:timeZone="Europe/Madrid" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <LinearLayout style="@style/WColumna">
            <TextView android:id="@+id/w_nombre0" style="@style/WNombre" />
            <TextView android:id="@+id/w_temp0" style="@style/WTemp" />
        </LinearLayout>

        <LinearLayout style="@style/WColumna">
            <TextView android:id="@+id/w_nombre1" style="@style/WNombre" />
            <TextView android:id="@+id/w_temp1" style="@style/WTemp" />
        </LinearLayout>

        <LinearLayout style="@style/WColumna">
            <TextView android:id="@+id/w_nombre2" style="@style/WNombre" />
            <TextView android:id="@+id/w_temp2" style="@style/WTemp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_euro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="1 € = —"
            android:textColor="@color/acento"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/w_actualizado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/texto_suave"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
